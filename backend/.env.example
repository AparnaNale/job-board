# Supabase / Postgres connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS - frontend deployed URL
FRONTEND_ORIGIN=http://localhost:3000

# Secret used to sign login JWTs. Generate a real random value:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Used only for the one-time offline tagging script (scripts/seed_data.py).
# The live chat assistant instead uses the API key the USER types into the
# frontend, sent per-request — it is never stored.
GEMINI_API_KEY_FOR_SEEDING=
